# ==============================================================================
# DATABASE CONFIGURATION (RAW POSTGRESQL - ZERO ORM)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kesit_db

# ==============================================================================
# AUTHENTICATION (BETTER AUTH - SELF-HOSTED)
# ==============================================================================
BETTER_AUTH_SECRET=generate_32_byte_cryptographic_random_string_here_12345
BETTER_AUTH_URL=http://localhost:3000
# Production: BETTER_AUTH_URL=https://exto.help

# Google OAuth Credentials (Restricted: ONLY Google OAuth enabled)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret

# ==============================================================================
# OPENROUTER AI GATEWAY (SERVER MANAGED KEY)
# NEVER prefix with NEXT_PUBLIC_ (Server-side secret)
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-your_server_managed_openrouter_api_key

# ==============================================================================
# LEMON SQUEEZY PAYMENTS & WEBHOOKS
# ==============================================================================
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMON_SQUEEZY_STORE_ID=your_store_id
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_hmac_sha256_signing_secret

# Optional Variant IDs for Packages (Defaults provided in src/config/billing.ts)
LEMON_VARIANT_STARTER=variant_starter_50
LEMON_VARIANT_PRO=variant_pro_200
LEMON_VARIANT_SCALE=variant_scale_600

